# Model (Gemini, via its OpenAI-compatible endpoint)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# GitHub (used by lib/github.js to push files)
GITHUB_TOKEN=
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=

# Supabase (used by lib/supabase.js to call the execute-sql Edge Function)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Vercel (used by lib/vercel.js to trigger a deploy)
VERCEL_DEPLOY_HOOK=
